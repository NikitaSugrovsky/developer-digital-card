# PostgreSQL connection string.
# локально: host = localhost
# в Docker Compose: host = postgres
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/developer_card?schema=public"

# HTTP-порт NestJS
PORT=3000

# development | production | test
NODE_ENV=development

# Значения для compose.yaml (можно переопределить в .env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=developer_card