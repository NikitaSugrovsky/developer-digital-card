generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String   @id @default(cuid())
  name        String
  description String
  email       String?  @unique
  githubUrl   String?
  linkedinUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skills     Skill[]
  experience Experience[]
  projects   Project[]

  @@map("profiles")
}

model Skill {
  id        String   @id @default(cuid())
  name      String
  category  String
  level     String?
  profileId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
  @@index([category])
  @@map("skills")
}

model Experience {
  id           String    @id @default(cuid())
  company      String
  position     String
  startDate    DateTime
  endDate      DateTime?
  description  String
  achievements String[]  @default([])
  profileId    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, company, position, startDate])
  @@index([profileId])
  @@index([startDate])
  @@map("experience")
}

model Project {
  id            String   @id @default(cuid())
  name          String
  description   String
  projectUrl    String?
  repositoryUrl String?
  technologies  String[] @default([])
  profileId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@index([profileId])
  @@map("projects")
}